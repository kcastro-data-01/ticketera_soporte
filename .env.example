# Copia este archivo como .env (no se sube a Git) y completa los valores.

# --- Asistente de IA ---
ASISTENTE_PROVEEDOR=qwen
QWEN_MODELO=qwen3:0.6b
# Segundos máximos de espera de la respuesta del modelo
QWEN_TIMEOUT=90
# true: la IA redacta los conteos con los datos del sistema (si tarda más de
# 20 s o cambia un dato, se usa la respuesta fija); false: siempre la fija
ASISTENTE_REDACTAR_CON_IA=true
# true: si las reglas no reconocen la pregunta (p. ej. mal escrita), la IA la
# clasifica (máx. 10 s) y el servidor calcula el conteo; false: va a la IA libre
ASISTENTE_INTERPRETAR_CON_IA=true
# ANTHROPIC_API_KEY=

# --- Tickets por correo (Microsoft Graph) ---
CORREO_ACTIVO=1
CORREO_USUARIO=kcastro@data.cr
# Datos de la app registrada en Microsoft Entra ID (sin secreto: device code)
CORREO_M365_TENANT=
CORREO_M365_CLIENT_ID=
# Carpeta del buzón a la que se mueven los correos ya procesados
CORREO_CARPETA_PROCESADOS=Tickets-Procesados
# auto = solo correos que piden ayuda; todos = cada correo es un ticket
CORREO_FILTRO=auto
CORREO_INTERVALO=60
# Fuera de Docker se puede elegir dónde guardar la caché de tokens
# CORREO_M365_CACHE=.msal_cache.json

# Dirección con la que los demás abren la app (va en los correos)
APP_URL=http://localhost:8000
