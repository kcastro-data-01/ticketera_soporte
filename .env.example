# Copia este archivo como .env (no se sube a Git) y completa los valores.

# --- Asistente de IA ---
ASISTENTE_PROVEEDOR=qwen
QWEN_MODELO=qwen3:0.6b
# Segundos máximos de espera de la respuesta del modelo
QWEN_TIMEOUT=90
# Límites de Ollama para que la ticketera siga respondiendo mientras la IA
# trabaja: núcleos y memoria máxima
OLLAMA_CPUS=4
OLLAMA_MEMORIA=1100m
# true: la IA redacta los conteos con los datos del sistema (si tarda más de
# 20 s o cambia un dato, se usa la respuesta fija); false: siempre la fija
ASISTENTE_REDACTAR_CON_IA=true
# true: si las reglas no reconocen la pregunta (p. ej. mal escrita), la IA la
# clasifica (máx. 10 s) y el servidor calcula el conteo; false: va a la IA libre
ASISTENTE_INTERPRETAR_CON_IA=true
# ANTHROPIC_API_KEY=
# Qwen en Groq (API gratis; lo que usa Vercel): ASISTENTE_PROVEEDOR=groq y la
# clave de https://console.groq.com/keys. En Docker no hace falta.
# GROQ_API_KEY=
# GROQ_MODELO=qwen/qwen3.8-27b
# Segundos máximos por petición a Groq (tope 25)
# GROQ_TIMEOUT=20

# --- Inicio de sesión con Microsoft (Entra ID) ---
# Usa la misma app registrada que el correo (CORREO_M365_TENANT y
# CORREO_M365_CLIENT_ID, más abajo), con la plataforma «Aplicación de página
# única» y la URI http://localhost:8000/login.html.
# Este correo entra siempre como Administrador; los demás, como Solicitante.
ADMIN_INICIAL=kcastro@data.cr
# Solo para desarrollo: true mantiene el inicio de sesión con contraseña
LOGIN_LOCAL=false

# --- Tickets por correo (Microsoft Graph) ---
CORREO_ACTIVO=1
CORREO_USUARIO=kcastro@data.cr
# Datos de la app registrada en Microsoft Entra ID (sin secreto; también
# sirven para el inicio de sesión con Microsoft)
CORREO_M365_TENANT=
CORREO_M365_CLIENT_ID=
# Carpeta del buzón a la que se mueven los correos ya procesados
CORREO_CARPETA_PROCESADOS=Tickets-Procesados
# ia = reglas fijas + la IA decide si es una solicitud (si la IA falla, filtro
# de palabras estricto); auto = solo palabras clave; todos = cada correo es un
# ticket. Si no está: ia cuando hay IA (ASISTENTE_PROVEEDOR), si no auto.
CORREO_FILTRO=ia
# Avisar por correo al asignado de un ticket creado desde un correo enviado
# (dejar en false mientras APP_URL sea localhost).
AVISAR_ASIGNADO=false
# Avisar por correo al solicitante y al asignado cuando alguien comenta desde
# la app (el correo trae «[Ticket #N]»: si responden, vuelve como comentario).
# Si no está: true en Vercel y false en Docker.
AVISAR_COMENTARIOS=false
CORREO_INTERVALO=60
# Remitentes de este dominio sin cuenta: no se crea el ticket; se les responde
# que primero ingresen con Microsoft. Los de otros dominios se ignoran (log).
DOMINIO_EMPRESA=data.cr
# Los tokens del buzón se guardan en la base de datos (tabla msal_cache).
# Archivo de caché de antes, que se importa una vez (fuera de Docker):
# CORREO_M365_CACHE=.msal_cache.json

# Dirección con la que los demás abren la app (va en los correos)
APP_URL=http://localhost:8000

# --- Versión de Vercel (README → «Publicar en Vercel») ---
# Estas van en las variables de Vercel, NUNCA en este archivo ni en Git:
# JWT_SECRET_KEY=   clave aleatoria para firmar las sesiones
# CRON_SECRET=      clave aleatoria que manda cron-job.org
# DATABASE_URL=     la pone la integración de Neon
# GROQ_API_KEY=    la clave de Groq, con ASISTENTE_PROVEEDOR=groq
# En Vercel cambian solos (VERCEL=1): ASISTENTE_PROVEEDOR=ninguno,
# CORREO_MODO=cron. Para forzarlos aquí:
# ASISTENTE_PROVEEDOR=ninguno
# CORREO_MODO=cron
